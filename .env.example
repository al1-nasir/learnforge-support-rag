# LLM Provider Configuration (Groq)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Vector Database (Qdrant Local Persistent Storage)
QDRANT_PATH=.storage/qdrant
QDRANT_COLLECTION=learnforge_support

# Embedding & Reranking Models
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Retrieval & Fusion Parameters
DENSE_TOP_K=8
SPARSE_TOP_K=8
FUSED_TOP_K=10
FINAL_TOP_K=5
RRF_K=60

# Conversation & Operational Settings
MAX_CONVERSATION_TURNS=6
LOG_LEVEL=INFO

