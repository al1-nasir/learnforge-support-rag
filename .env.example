# LLM Provider Configuration (Groq)
GROQ_API_KEY=
# Supported models on Groq: qwen/qwen3.8-27b (used for published benchmark evaluations), openai/gpt-oss-20b, openai/gpt-oss-120b
LLM_MODEL=qwen/qwen3.8-27b

# Vector Database (Qdrant Local Persistent Storage)
QDRANT_PATH=.storage/qdrant
QDRANT_COLLECTION=learnforge_support

# Embedding & Reranking Models
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Retrieval & Fusion Parameters
DENSE_TOP_K=8
SPARSE_TOP_K=8
FUSED_TOP_K=10
FINAL_TOP_K=5
RRF_K=60

# Conversation & Operational Settings
MAX_CONVERSATION_TURNS=6
LOG_LEVEL=INFO

# Observability Configuration (Langfuse v4) - Optional & Non-Participating
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=demo

